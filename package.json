{
  "name": "folio-local",
  "private": true,
  "version": "1.20.26",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "assets": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-build-artifacts.mjs",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "release": "node scripts/release.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "smoke": "node scripts/run-smoke.mjs",
    "test:reader-security": "node scripts/test-reader-security.mjs && node scripts/test-url-client-certificates.mjs",
    "test:chat-math": "node scripts/test-chat-math.mjs",
    "test:thumbnails": "node scripts/test-thumbnails.mjs",
    "test:content": "node --test scripts/test-content-files.cjs scripts/test-content-source.mjs scripts/test-html-preview.mjs scripts/test-csv.mjs scripts/test-xlsx-files.cjs scripts/test-markdown-sections.mjs && node scripts/smoke-content.mjs && node scripts/smoke-markdown-modes.mjs && node scripts/test-photo-codec.mjs && node scripts/smoke-photo-tools.mjs && node scripts/smoke-photo-view.mjs && node scripts/smoke-pen-width.mjs && node scripts/smoke-draw-layering.mjs",
    "build:local": "npm run build && electron-builder --config electron-builder.local.cjs --mac zip --arm64 --publish never",
    "test:document-tools": "node scripts/test-text-markup.mjs && node scripts/test-pdf-pages.mjs && node scripts/test-pdf-security.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@embedpdf/pdfium": "2.15.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/emscripten": "^1.41.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "idb-keyval": "^6.3.0",
    "katex": "^0.19.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "parse5": "7.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-math": "^6.0.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "productName": "Doko",
  "description": "PDF, Markdown, and photo-folder reader",
  "license": "MIT",
  "homepage": "https://doko.lt",
  "bugs": {
    "email": "roquscode@gmail.com"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.folio.local",
    "productName": "Doko",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/mammoth/mammoth.browser*.js",
      "!dist/**/* [0-9]*.*",
      "!dist/**/* [0-9]*/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Doko",
      "artifactName": "Doko-Setup.exe"
    },
    "portable": {
      "artifactName": "Doko-Portable.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "icon": "build/icon.png"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "gif",
          "bmp",
          "avif"
        ],
        "name": "Image",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "roqusanalytics",
        "repo": "doko",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "dist/.vite/license.md",
        "to": "licenses/THIRD_PARTY_LICENSES.md"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "brand/doko/logos/Doko.icon",
      "fileAssociations": [
        {
          "ext": [
            "docx",
            "doc"
          ],
          "name": "Word Document",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "txt",
          "name": "Text Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": "csv",
          "name": "CSV Document",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": "svg",
          "name": "SVG Image",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": "xlsx",
          "name": "Excel Workbook",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Doko-mac.${ext}"
    },
    "dmg": {
      "artifactName": "Doko-mac.dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "synopsis": "A simple, clean PDF reader",
      "maintainer": "Forward Future <748450+mberman84@users.noreply.github.com>",
      "mimeTypes": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/msword",
        "text/markdown",
        "text/x-markdown",
        "text/plain",
        "text/csv",
        "text/html",
        "image/svg+xml",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/gif",
        "image/bmp",
        "image/avif"
      ],
      "executableName": "folio-local",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "build/linux/folio-archive-keyring.gpg",
          "to": "folio-archive-keyring.gpg"
        }
      ]
    },
    "appImage": {
      "artifactName": "Doko-linux-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "Doko-linux-amd64.deb",
      "afterInstall": "build/linux/after-install.tpl",
      "afterRemove": "build/linux/after-remove.tpl"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/roqusanalytics/doko.git"
  },
  "author": "Forward Future",
  "desktopName": "folio-local.desktop",
  "overrides": {
    "katex": "$katex",
    "minimatch@>=7 <11.0.1": "11.0.6"
  },
  "folioLocal": true
}
